<odoo>
    <record id="hr_accrual_plan_view_form" model="ir.ui.view">
        <field name="name">Add Accrual by Tag fields to Accrual Plan form view</field>
        <field name="model">hr.leave.accrual.plan</field>
        <field name="inherit_id" ref="hr_holidays.hr_accrual_plan_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group name="generate_by_tag" string="Generate by Tag">
                    <field
                        name="generate_allocation_category_ids"
                        string="Tags"
                        widget="many2many_tags"
                    />
                    <field
                        name="generate_allocation_default_status_id"
                        string="Default Time Off Type"
                        invisible="not generate_allocation_category_ids"
                        required="generate_allocation_category_ids"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
