<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edit_holiday_status_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form.timesheet.project.task</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='visual']" position="before">
                <group
                    name="timesheet"
                    string="Timesheets"
                    class="mw-100 col-lg-12"
                    invisible="time_type == 'other'"
                >
                    <div class="text-muted mb-4" colspan="2">
                        Log the timesheets generated for this time off type on a
                        dedicated project and task instead of the company
                        default.
                    </div>
                    <!-- Referenced by the domain of timesheet_project_id; the
                         base view only shows it to base.group_multi_company. -->
                    <field name="company_id" invisible="1" />
                    <field
                        name="timesheet_project_id"
                        context="{'active_test': False}"
                    />
                    <field
                        name="timesheet_task_id"
                        context="{'active_test': False, 'default_project_id': timesheet_project_id}"
                        invisible="not timesheet_project_id"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
