<odoo>
    <record model="ir.ui.view" id="hr_leave_allocation_generate_multi_wizard_form_view">
        <field name="model">hr.leave.allocation.generate.multi.wizard</field>
        <field
            name="inherit_id"
            ref="hr_holidays.hr_leave_allocation_generate_multi_wizard_view_form"
        />
        <field name="arch" type="xml">
            <field name="holiday_status_id" position="before">
                <field
                    name="domain"
                    widget="domain"
                    invisible="allocation_mode != 'domain'"
                    options="{'foldable': True, 'model': 'hr.employee'}"
                />
            </field>
        </field>
    </record>
</odoo>
