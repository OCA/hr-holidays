<odoo>
    <record id="hr_leave_rule_responsible_read_manager_hierarchy" model="ir.rule">
        <field name="name">Time Off Responsible: read team hierarchy</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field
            name="domain_force"
        >[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('hr_holidays.group_hr_holidays_responsible'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="hr_leave_rule_responsible_update_manager_hierarchy" model="ir.rule">
        <field name="name">Time Off Responsible: approve team hierarchy</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field name="domain_force">[
            ('holiday_type', '=', 'employee'),
            ('employee_id', 'child_of', user.employee_ids.ids),
            ('employee_id', 'not in', user.employee_ids.ids),
        ]</field>
        <field
            name="groups"
            eval="[(4, ref('hr_holidays.group_hr_holidays_responsible'))]"
        />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

</odoo>
