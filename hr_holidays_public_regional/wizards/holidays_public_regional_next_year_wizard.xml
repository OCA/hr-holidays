<odoo>
    <record id="holidays_public_regional_next_year_wizard_view" model="ir.ui.view">
        <field name="name">Create Next Year Public Regional Holidays</field>
        <field name="model">public.regional.holidays.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Next Year Public Regional Holidays">
                <sheet>
                    <group>
                        <field name="template_ids" />
                        <field name="year" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="create_public_regional_holidays"
                        string="Create"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record
        id="action_create_next_year_public_regional_holidays"
        model="ir.actions.act_window"
    >
        <field name="name">Create Next Year Public Regional Holidays</field>
        <field name="res_model">public.regional.holidays.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem
        action="action_create_next_year_public_regional_holidays"
        id="menu_create_next_year_public_regional_holidays"
        parent="hr_holidays_public.menu_hr_public_holidays"
        groups="hr_holidays.group_hr_holidays_manager"
        sequence="30"
    />
</odoo>
