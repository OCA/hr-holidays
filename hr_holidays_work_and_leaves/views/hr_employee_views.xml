<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_planning_button" model="ir.ui.view">
        <field name="name">hr.employee.form.planning.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_show_planning"
                    type="object"
                    string="Show Employee Planning"
                    class="oe_stat_button"
                    icon="fa-calendar"
                />
            </xpath>
        </field>
    </record>
</odoo>
