<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_employee_planning_form" model="ir.ui.view">
        <field name="name">hr.employee.planning.form</field>
        <field name="model">hr.employee.planning</field>
        <field name="arch" type="xml">
            <form string="Employee Planning">
                <div class="oe_title">
                    <h1>
                        <field name="employee_id" readonly="1" />
                    </h1>
                </div>
                <group>
                    <field name="date_start" />
                    <field name="date_end" />
                </group>
                <footer>
                    <button
                        name="action_compute"
                        type="object"
                        string="Compute Planning"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Close" />
                </footer>
                <group string="Planning" col="1" colspan="6">
                    <field name="planning_line_ids" nolabel="1">
                        <tree>
                            <field name="date" />
                            <field name="hours_work" />
                            <field name="hours_leave" />
                            <field name="hours_holiday" />
                        </tree>
                    </field>
                </group>
            </form>
        </field>
    </record>
</odoo>
