<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form public holiday region</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payroll_information']//field[@name='resource_calendar_id']"
                position="after"
            >
                <field name="public_holiday_region_id" />
            </xpath>
        </field>
    </record>
</odoo>
